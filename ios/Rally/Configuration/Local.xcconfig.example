// Copy to Local.xcconfig (git-ignored). All values below are public app settings.
// xcconfig treats // as a comment, so preserve the empty expansion in https:/$()/.
RALLY_CONVEX_URL = https:/$()/YOUR_DEPLOYMENT.convex.cloud
AUTH0_DOMAIN = YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID = YOUR_NATIVE_APPLICATION_CLIENT_ID

// Set your development team locally to install on a physical device.
// DEVELOPMENT_TEAM = YOUR_TEAM_ID
