# Convex CLI deployment selection, generated by `npx convex dev` in .env.local.
CONVEX_DEPLOYMENT=

# Public backend URL used by the worker, generated by `npx convex dev`.
CONVEX_URL=

# Public Convex HTTP actions URL for provider webhooks.
CONVEX_SITE_URL=

# Public Auth0 issuer and application Client ID; never use the Client Secret here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Optional local-only ID token for `npm run domain:setup`.
# `npm run auth:login` obtains, validates and privately saves it after browser login.
# Never set this in Convex, an example file or git. Rerun login when it expires.
RALLY_AUTH0_ID_TOKEN=

# Set these on the selected Convex development deployment, not in an iOS app.
# Photon project: 4dad8b60-5af7-483c-91fa-d9f806d7c63a
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Server-only 32-byte hex key for encrypted inbox records and invitation codes.
# `npm run messaging:configure` creates it if missing and preserves existing keys.
RALLY_MESSAGING_KEY=

# Matching private credential on this Mac and the Convex server; 32–512 characters.
# `npm run worker:configure` preserves the server key or creates 32 random bytes.
# Never include this in the iOS app.
RALLY_WORKER_TOKEN=
# Local CLI: claude (default) or codex. Uses the CLI's subscription login.
RALLY_PROVIDER=
# Select a model from the authenticated provider's live catalogue.
# ANTHROPIC_API_KEY, OPENAI_API_KEY and CODEX_API_KEY are rejected.
RALLY_MODEL=
