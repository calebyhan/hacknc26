# Convex CLI deployment selection, generated by `npx convex dev` in .env.local.
CONVEX_DEPLOYMENT=

# Public backend URL used by the worker, generated by `npx convex dev`.
CONVEX_URL=

# Public Convex HTTP actions URL for provider webhooks.
CONVEX_SITE_URL=

# Set these on the selected Convex development deployment, not in an iOS app.
# Photon project: 4dad8b60-5af7-483c-91fa-d9f806d7c63a
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Server-only 32-byte hex key for encrypted inbox records and invitation codes.
# `npm run messaging:configure` creates it if missing and preserves existing keys.
RALLY_MESSAGING_KEY=

# Lane C configures a matching server-side credential before implementing the queue.
# The bootstrap worker only validates these values; it does not connect or invoke a model.
RALLY_WORKER_TOKEN=
RALLY_MODEL=
